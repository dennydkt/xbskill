{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dennydkt/xbskill/schemas/conversation-ontology-v1.json",
  "title": "xbskill conversation ontology delta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "generated_at",
    "authorized_current_session",
    "authorized_sensitive_long_term",
    "entities",
    "assertions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "session_id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{4}-[A-Za-z0-9_\\-\\u3400-\\u9fff]{1,96}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "authorized_current_session": {"const": true},
    "authorized_sensitive_long_term": {"type": "boolean"},
    "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}}
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "turn", "role", "excerpt"],
      "properties": {
        "session_id": {"type": "string"},
        "turn": {"type": "integer", "minimum": 1},
        "role": {"enum": ["user", "assistant"]},
        "excerpt": {"type": "string", "minLength": 1, "maxLength": 280}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "entity_type", "canonical_name", "aliases", "scope", "sensitivity", "status", "source_refs"],
      "properties": {
        "entity_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._-]{0,95}$"},
        "entity_type": {"enum": ["person", "organization", "project", "goal", "work_item", "artifact", "decision", "event", "constraint", "capability", "preference", "role", "topic"]},
        "canonical_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "aliases": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 160}, "uniqueItems": true},
        "scope": {"type": "string", "minLength": 1, "maxLength": 200},
        "sensitivity": {"enum": ["normal", "restricted"]},
        "status": {"enum": ["active", "candidate", "needs_identity", "retired"]},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/source_ref"}, "minItems": 1}
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["entity", "literal"]},
        "entity_id": {"type": "string"},
        "value": {"type": ["string", "number", "boolean"]},
        "value_type": {"enum": ["string", "number", "boolean", "date", "datetime", "duration", "status"]}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "subject_id", "predicate", "object", "epistemic_status", "confidence", "lifecycle", "retention", "sensitivity", "scope", "observed_at", "valid_from", "valid_until", "source_refs", "reversal", "supersedes", "qualifiers"],
      "properties": {
        "assertion_id": {"type": "string", "pattern": "^a:[a-z0-9][a-z0-9._:-]{2,127}$"},
        "subject_id": {"type": "string"},
        "predicate": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "object": {"$ref": "#/$defs/object"},
        "epistemic_status": {"enum": ["user_statement", "observable_event", "assistant_inference", "user_decision", "artifact_evidence"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "lifecycle": {"enum": ["active", "candidate", "disputed", "superseded", "expired"]},
        "retention": {"enum": ["long_term", "session_only"]},
        "sensitivity": {"enum": ["normal", "restricted"]},
        "scope": {"type": "string", "minLength": 1, "maxLength": 200},
        "observed_at": {"type": "string", "format": "date-time"},
        "valid_from": {"type": ["string", "null"], "format": "date-time"},
        "valid_until": {"type": ["string", "null"], "format": "date-time"},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/source_ref"}, "minItems": 1},
        "reversal": {"type": "string", "minLength": 1, "maxLength": 400},
        "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "qualifiers": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}
      }
    }
  }
}
