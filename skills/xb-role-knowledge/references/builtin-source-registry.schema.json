{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xbskill.local/schemas/role-knowledge-builtin-source-registry-v1.json",
  "title": "xbskill Builtin Role Knowledge Source Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type", "schema_version", "registry_id", "registry_version", "captured_at",
    "ledger_file", "ledger_sha256", "license_policies", "security_profiles", "sources"
  ],
  "properties": {
    "record_type": {"const": "RoleKnowledgeBuiltinSourceRegistry"},
    "schema_version": {"type": "integer", "const": 1},
    "registry_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "captured_at": {"type": "string", "format": "date-time"},
    "ledger_file": {"const": "xbskill/references/specialty-source-ledger.md"},
    "ledger_sha256": {"$ref": "#/$defs/sha256"},
    "license_policies": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "scope", "basis"],
        "properties": {
          "status": {"const": "approved"},
          "scope": {"const": "facts_and_functional_relationships_only_no_verbatim_assets"},
          "basis": {"type": "string", "minLength": 1}
        }
      }
    },
    "security_profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["review_status", "content_policy", "execution_authorized"],
        "properties": {
          "review_status": {"const": "reviewed"},
          "content_policy": {"const": "untrusted_data_no_execute"},
          "execution_authorized": {"const": false}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "status", "active_for_role_knowledge", "row_sha256", "pin",
          "license_policy_id", "security_profile_id"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^(?:OFF|GH)-[A-Z0-9]+$"},
          "status": {"enum": ["activated", "supporting", "discovery_only", "rejected"]},
          "active_for_role_knowledge": {"type": "boolean"},
          "row_sha256": {"$ref": "#/$defs/sha256"},
          "pin": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "value"],
            "properties": {
              "kind": {"enum": ["git_commit", "retrieval_date"]},
              "value": {"type": "string", "minLength": 10}
            }
          },
          "license_policy_id": {"type": "string", "minLength": 1},
          "security_profile_id": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
